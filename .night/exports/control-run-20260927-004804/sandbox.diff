+/// Извлечь хост из URL: подстрока между `://` и первым из `/ ? #`.
+/// У `file://` хост пуст.
+fn extract_host(url: &str) -> String {
+    let scheme_end = url
+        .find("://")
+        .map(|i| i + 3)
+        .unwrap_or(0);
+    let rest = &url[scheme_end..];
+    let end = rest
+        .find(|c: char| ['/', '?', '#'].contains(&c))
+        .unwrap_or(rest.len());
+    rest[..end].to_owned()
+}

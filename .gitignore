/target
**/*.rs.bk
.env
*.age
.nexus/pending/*
!.nexus/pending/.gitkeep
# OMO пишет служебные файлы в .sisyphus — трекаем ТОЛЬКО планы
.sisyphus/*
!.sisyphus/plans/
.opencode/*.log
# ablation-харнесс: снапшоты, результаты, xdg-изоляция, сгенерированные конфиги (с ключами)
.ablation/
# временно переименованные конфиги во время вариантов
*.ablation_bak_*

# рабочие дерева и артефакты воркеров не принадлежат репозиторию
/.worktrees/
/.sisyphus/plans/**/*.result.*
/.ablation*/
!/.ablation-solpi/
!/.ablation-omp/
# внутри .ablation-omp трекаются только артефакты протокола (PROBE/REPORT/harness);
# установка на 154M, прогоны и песочницы — вне репозитория
/.ablation-omp/omp-install/
/.ablation-omp/scratch-*/
/.ablation-omp/runs/
/.ablation-omp/*.txt
# внутри .ablation-solpi трекаются только артефакты протокола (BRIEF/STATE/workloads/
# scripts/ledger.tsv/REPORT.md); рантайм и копии auth.json — вне репозитория
/.ablation-solpi/harness.sh
/.ablation-solpi/pi-home*/
/.ablation-solpi/runs/
/.ablation-solpi/src/
/.ablation-solpi/wt/
/.ablation-solpi/reports/
/.ablation-solpi/results/
/.stellwerk/pending/

# OMO runtime/evidence артефакты — конфиг .omo/omo.jsonc остаётся трекаемым
.omo/run-continuation/
.omo/plans/**/*.result.*
.omo/*.bak.*
.pf/
.debug-journal.md
**/__pycache__/
